# Copy to .env and fill in. Never commit .env.

# Public address (the Cloudflare Tunnel hostname). Used for the Google redirect.
INVENTARIUS_BASE_URL=https://inventarius.portospaceteam.pt
# Short address printed inside QR labels (point it at the same app).
INVENTARIUS_LABEL_URL=https://inv.portospaceteam.pt

# Google sign-in: create an OAuth client ("Web application") in the team's
# Google Cloud project with redirect URI <BASE_URL>/auth/callback.
INVENTARIUS_GOOGLE_CLIENT_ID=
INVENTARIUS_GOOGLE_CLIENT_SECRET=
INVENTARIUS_ALLOWED_DOMAIN=portospaceteam.pt
# Comma-separated emails that become admins on first login.
INVENTARIUS_ADMINS=

# Until Google sign-in is set up: password-less login. NEVER with a public tunnel.
INVENTARIUS_DEV_AUTH=false

# Labels: datamatrix (default, scanned in the app), qr (phone camera opens it) or code128.
INVENTARIUS_SYMBOLOGY=datamatrix
# Set to true if labels come out upside down.
INVENTARIUS_PRINT_FLIP=false
PRINTER_DEVICE=/dev/usb/lp0

# Cloudflare Tunnel token (Zero Trust → Networks → Tunnels → your tunnel).
CLOUDFLARE_TUNNEL_TOKEN=

# Where Litestream writes the backup (ideally another disk).
BACKUP_DIR=./backup
# For an S3/R2 replica (see litestream.yml):
# LITESTREAM_ACCESS_KEY_ID=
# LITESTREAM_SECRET_ACCESS_KEY=
